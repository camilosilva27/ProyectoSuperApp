# Copiar a backend/.env y completar. .env está en .gitignore — no se commitea.

# Puerto local del server (en el VPS va detrás de Caddy/nginx en 443)
PORT=3000

NODE_ENV=development

# --- Fase 2 (Plan_Usuarios_y_cobros.md): sesión + Mercado Pago ---
# Sin estas variables, /api/pagos/suscripcion y /api/webhooks/mercadopago responden 503 en
# vez de romper el resto del server (comparar/catálogo no dependen de ninguna de estas).

# Dashboard de Supabase > Project Settings > API > JWT Settings > "JWT Secret".
SUPABASE_JWT_SECRET=

# Dashboard de Supabase > Project Settings > API. Para el cliente con service role key que
# usa el webhook para escribir en perfil_usuario (bypasea RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago Developers > tu aplicación > Credenciales de producción (o de prueba mientras
# se testea en sandbox).
MERCADOPAGO_ACCESS_TOKEN=

# Mercado Pago Developers > tu aplicación > Webhooks > "Firma secreta" — para validar que una
# notificación de webhook realmente viene de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# Precio mensual de la suscripción premium, en ARS. Sin decidir todavía — sin este valor, la
# ruta de alta de suscripción responde 503 en vez de inventar un número.
MERCADOPAGO_PRECIO_MENSUAL_ARS=

# A dónde vuelve el navegador/webview de MP cuando el usuario termina el checkout. Default en
# el código: https://mi-superapp.vercel.app (revisar si conviene una URL más específica, ej.
# la pantalla de ajustes, una vez que se pruebe el flujo real).
URL_VUELTA_CHECKOUT_MP=
